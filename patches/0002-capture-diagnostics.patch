+/// Experimental capture counters, cumulative across this manager's streams.
+/// Allocated before the PipeWire thread starts. The RT callback only performs
+/// native AtomicU64 operations (the experiment targets x86_64) and inspects the
+/// existing handoff result; it does not allocate, log, lock, or wait for metrics.
+#[derive(Default)]
+struct CaptureDiagnostics {
+    process_entries: AtomicU64,
+    buffers_dequeued: AtomicU64,
+    dequeues_empty: AtomicU64,
+    handoffs_ok: AtomicU64,
+    handoffs_full: AtomicU64,
+    handoffs_disconnected: AtomicU64,
+    receiver_delivered: AtomicU64,
+}
+
+impl CaptureDiagnostics {
+    #[inline]
+    fn record_handoff(&self, result: &std::result::Result<(), std_mpsc::TrySendError<VideoFrame>>) {
+        let counter = match result {
+            Ok(()) => &self.handoffs_ok,
+            Err(std_mpsc::TrySendError::Full(_)) => &self.handoffs_full,
+            Err(std_mpsc::TrySendError::Disconnected(_)) => &self.handoffs_disconnected,
+        };
+        counter.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// Called only on the PipeWire main-loop thread, never from process().
+    /// Individual loads are approximate concurrent samples, not a transaction.
+    fn report(&self, stream_count: usize) {
+        info!(
+            target: "hardsignal_capture_diag",
+            streams = stream_count,
+            process_entries = self.process_entries.load(Ordering::Relaxed),
+            buffers_dequeued = self.buffers_dequeued.load(Ordering::Relaxed),
+            dequeues_empty = self.dequeues_empty.load(Ordering::Relaxed),
+            handoffs_ok = self.handoffs_ok.load(Ordering::Relaxed),
+            handoffs_full = self.handoffs_full.load(Ordering::Relaxed),
+            handoffs_disconnected = self.handoffs_disconnected.load(Ordering::Relaxed),
+            receiver_delivered = self.receiver_delivered.load(Ordering::Relaxed),
+            "Lamco capture diagnostics: cumulative totals across all PipeWire streams"
+        );
+    }
+}
